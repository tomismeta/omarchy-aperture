#!/bin/bash

# omarchy:summary=Manage the Aperture integration for OMP
# omarchy:args=<activate|deactivate|status>
# omarchy:examples=~/.config/omarchy/plugins/aperture/bin/omarchy-aperture-omp activate | ~/.config/omarchy/plugins/aperture/bin/omarchy-aperture-omp deactivate

set -euo pipefail

plugin_id="@tomismeta/aperture-omp"

fail() {
  printf 'omarchy-aperture-omp: %s\n' "$1" >&2
  exit 1
}

[[ -e ${BASH_SOURCE[0]} || -L ${BASH_SOURCE[0]} ]] || fail "installed command path is missing"
script_path=$(realpath "${BASH_SOURCE[0]}") || fail "cannot resolve command path"
bin_dir=${script_path%/*}
plugin_dir=${bin_dir%/*}
verify_command="$bin_dir/omarchy-aperture-verify-payload"
remove_command="$bin_dir/omarchy-aperture-pre-remove"
integration="$plugin_dir/integrations/omp"

file_identity() {
  stat -c '%d:%i:%s:%a' "$1" 2>/dev/null || stat -f '%d:%i:%z:%Lp' "$1"
}

# This guard serializes Aperture lifecycle commands, not foreign OMP writers.
with_lifecycle_lock() {
  local lock_parent="$HOME/.omp" lock_dir="$HOME/.omp/.aperture-lifecycle.lock"
  mkdir -p -- "$lock_parent"
  [[ -d $lock_parent && ! -L $lock_parent && -O $lock_parent ]] ||
    fail "lifecycle lock parent is unsafe"
  mkdir -m 700 -- "$lock_dir" 2>/dev/null ||
    fail "another Aperture lifecycle operation owns $lock_dir; do not run concurrent OMP plugin mutations"
  printf '%s\n' "$$" >"$lock_dir/owner"
  release_lifecycle_lock() {
    local status_code=$?
    trap - EXIT
    if [[ -d $lock_dir && ! -L $lock_dir && -O $lock_dir &&
          -f $lock_dir/owner && ! -L $lock_dir/owner &&
          $(cat -- "$lock_dir/owner") == "$$" ]]; then
      rm -- "$lock_dir/owner"
      rmdir -- "$lock_dir"
    fi
    exit "$status_code"
  }
  trap release_lifecycle_lock EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  APERTURE_LIFECYCLE_OWNER=$$ "$@"
  release_lifecycle_lock
}

run_omp() {
  (cd "$HOME" && omp "$@")
}
resume_service() {
  command -v omarchy-shell >/dev/null 2>&1 ||
    fail "Aperture service control is unavailable"
  local plugins enabled result attempt
  plugins=$(omarchy-shell shell listPlugins 2>/dev/null) ||
    fail "The shell plugin state could not be read"
  enabled=$(jq -er '
    [.[] | select(.id == "aperture")] as $matches
    | if ($matches | length) == 1 and ($matches[0].enabled | type) == "boolean"
      then ($matches[0].enabled | tostring) else error("invalid plugin state") end
  ' <<<"$plugins") || fail "Aperture is not a known shell plugin"
  if [[ $enabled == "false" ]]; then
    shell_was_disabled=1
    result=$(omarchy-shell shell setPluginEnabled aperture true 2>/dev/null) ||
      fail "The shell could not enable Aperture"
    [[ $result == "ok" ]] || fail "The shell refused to enable Aperture"
  fi
  local prior_status="" status
  for (( attempt = 0; attempt < 50; attempt++ )); do
    prior_status=$(omarchy-shell aperture.worker status 2>/dev/null) || prior_status=""
    if jq -e 'type == "object" and (.shutdownRequested | type == "boolean")' \
        <<<"$prior_status" >/dev/null 2>&1; then break; fi
    sleep 0.1
  done
  (( attempt < 50 )) || fail "The Aperture service did not report valid lifecycle state"
  if jq -e '.shutdownRequested == true' <<<"$prior_status" >/dev/null; then
    service_was_shutdown=1
  fi
  status=$(omarchy-shell aperture.worker resume 2>/dev/null) ||
    fail "The Aperture service refused resume"
  jq -e 'type == "object" and .shutdownRequested == false' <<<"$status" >/dev/null ||
    fail "The Aperture service did not accept resume"
}


candidate_roots() {
  if [[ -n ${XDG_DATA_HOME:-} ]]; then printf '%s\n' "$XDG_DATA_HOME/omp/plugins"; fi
  printf '%s\n' "$HOME/.omp/plugins"
}

verify_existing_state() {
  local expected="$1" root package lock target owned_count=0 owned_root=""
  while IFS= read -r root; do
    [[ -n $root ]] || continue
    package="$root/node_modules/@tomismeta/aperture-omp"
    lock="$root/omp-plugins.lock.json"
    if [[ -e $package || -L $package ]]; then
      [[ -L $package ]] || fail "refusing non-symlink OMP package path: $package"
      target=$(realpath "$package") || fail "cannot resolve OMP package link: $package"
      [[ $target == "$expected" ]] || fail "OMP package link points at an unexpected payload: $target"
      (( owned_count += 1 ))
      owned_root="$root"
    fi
    if [[ -e $lock || -L $lock ]]; then
      [[ -f $lock && ! -L $lock ]] || fail "OMP plugin lock is unsafe: $lock"
      jq -e 'type == "object" and (.plugins | type == "object") and (.settings | type == "object")' \
        "$lock" >/dev/null || fail "OMP plugin lock is malformed: $lock"
      if jq -e --arg id "$plugin_id" '(.plugins | has($id)) or (.settings | has($id))' "$lock" >/dev/null; then
        [[ -L $package ]] || fail "OMP lock contains Aperture without an owned package symlink"
      fi
    fi
    if [[ -e $package || -L $package ]]; then
      [[ -f $lock && ! -L $lock ]] ||
        fail "owned OMP package link has no safe lock file"
      jq -e --arg id "$plugin_id" '.plugins[$id] != null' "$lock" >/dev/null ||
        fail "owned OMP package link has no corresponding plugin lock entry"
    fi
  done < <(candidate_roots | awk '!seen[$0]++')
  (( owned_count <= 1 )) || fail "Aperture OMP integration exists in multiple plugin roots"
  printf '%s\n' "$owned_root"
}

# Activation owns only a new registration, never the shell's existing widget
# settings or durable worker state. Full deactivation deliberately removes both.
rollback_new_registration() {
  local root package lock target lock_tmp lock_mode package_present package_identity lock_identity lock_original
  while IFS= read -r root; do
    package="$root/node_modules/@tomismeta/aperture-omp"
    lock="$root/omp-plugins.lock.json"
    package_present=0
    if [[ -e $package || -L $package ]]; then
      [[ -L $package ]] || return 1
      target=$(realpath "$package") || return 1
      [[ $target == "$expected" ]] || return 1
      package_present=1
      package_identity=$(file_identity "$package") || return 1
    fi
    # A failed link may leave only the symlink or only its lock entries.
    if [[ ! -e $lock && ! -L $lock ]]; then
      if (( package_present )); then
        [[ -L $package && $(file_identity "$package") == "$package_identity" &&
           $(realpath "$package") == "$expected" ]] || return 1
        rm -- "$package" || return 1
      fi
      continue
    fi
    [[ -f $lock && ! -L $lock ]] || return 1
    lock_identity=$(file_identity "$lock") || return 1
    lock_original=$(cat -- "$lock") || return 1
    jq -e 'type == "object" and (.plugins | type == "object") and (.settings | type == "object")' \
      <<<"$lock_original" >/dev/null || return 1
    if ! jq -e --arg id "$plugin_id" '.plugins | has($id)' <<<"$lock_original" >/dev/null &&
        ! jq -e --arg id "$plugin_id" '.settings | has($id)' <<<"$lock_original" >/dev/null; then
      if (( package_present )); then
        [[ -L $package && $(file_identity "$package") == "$package_identity" &&
           $(realpath "$package") == "$expected" &&
           -f $lock && ! -L $lock && $(file_identity "$lock") == "$lock_identity" &&
           $(cat -- "$lock") == "$lock_original" ]] || return 1
        rm -- "$package" || return 1
      fi
      continue
    fi
    lock_mode=$(stat -c '%a' "$lock" 2>/dev/null || stat -f '%Lp' "$lock") || return 1
    lock_tmp=$(mktemp "$root/.omp-plugins.lock.json.XXXXXX") || return 1
    if ! jq --arg id "$plugin_id" 'del(.plugins[$id]) | del(.settings[$id])' \
        <<<"$lock_original" >"$lock_tmp" || ! chmod "$lock_mode" "$lock_tmp"; then
      rm -f -- "$lock_tmp"
      return 1
    fi
    if [[ ! -f $lock || -L $lock || $(file_identity "$lock") != "$lock_identity" ||
          $(cat -- "$lock") != "$lock_original" ]] ||
        { (( package_present )) && [[ ! -L $package || $(file_identity "$package") != "$package_identity" ||
                                      $(realpath "$package") != "$expected" ]]; }; then
      rm -f -- "$lock_tmp"
      return 1
    fi
    if (( package_present )) && ! rm -- "$package"; then
      rm -f -- "$lock_tmp"
      return 1
    fi
    if ! mv -Tf -- "$lock_tmp" "$lock" 2>/dev/null; then
      if [[ ! -f $lock || -L $lock ]] || ! mv -f -- "$lock_tmp" "$lock"; then
        if (( package_present )); then ln -s -- "$expected" "$package" || true; fi
        rm -f -- "$lock_tmp"
        return 1
      fi
    fi
  done < <(candidate_roots | awk '!seen[$0]++')
}

activate() (
  local expected version existing_root prior_enabled=0 service_was_shutdown=0 shell_was_disabled=0
  local mutation_kind="none" rollback_failed=0

  rollback_activation() {
    local status_code=$?
    trap - EXIT
    if (( status_code != 0 )); then
      if [[ $mutation_kind == "new" ]]; then
        rollback_new_registration || rollback_failed=1
      elif [[ $mutation_kind == "enabled-prior-disabled" ]]; then
        run_omp plugin disable "$plugin_id" >/dev/null 2>&1 || rollback_failed=1
      fi
      if (( service_was_shutdown )); then
        omarchy-shell aperture.worker shutdown >/dev/null 2>&1 || rollback_failed=1
      fi
      if (( shell_was_disabled )); then
        if [[ $(omarchy-shell shell setPluginEnabled aperture false 2>/dev/null) != "ok" ]]; then
          rollback_failed=1
        fi
      fi
      if (( rollback_failed )); then
        printf 'omarchy-aperture-omp: warning: activation rollback needs manual repair\n' >&2
      fi
    fi
    exit "$status_code"
  }

  "$verify_command" --require-production >/dev/null
  [[ -d $integration && ! -L $integration ]] || fail "trusted OMP integration directory is missing"
  expected=$(realpath "$integration") || fail "cannot resolve trusted OMP integration"
  version=$(run_omp --version 2>/dev/null) || fail "OMP is unavailable"
  [[ $version =~ ^omp/([0-9]+)(\.[0-9]+){2}$ ]] || fail "OMP returned an invalid version: $version"
  (( 10#${BASH_REMATCH[1]} >= 18 )) || fail "OMP 18 or newer is required"

  printf 'Registering Aperture with OMP...\n'
  existing_root=$(verify_existing_state "$expected")
  if [[ -n $existing_root ]] &&
      jq -e --arg id "$plugin_id" '.plugins[$id].enabled == true' \
        "$existing_root/omp-plugins.lock.json" >/dev/null; then
    prior_enabled=1
  fi
  trap rollback_activation EXIT
  resume_service
  if [[ -n $existing_root ]]; then
    if (( ! prior_enabled )); then mutation_kind="enabled-prior-disabled"; fi
    run_omp plugin enable "$plugin_id" >/dev/null
  else
    mutation_kind="new"
    run_omp plugin link "$expected" --scope user >/dev/null
  fi

  linked_root=$(verify_existing_state "$expected")
  [[ -n $linked_root ]] || fail "OMP activation did not create the expected user link"
  listing=$(run_omp plugin list --json)
  count=$(jq -r --arg id "$plugin_id" '[.npm[]? | select(.name == $id)] | length' <<<"$listing")
  enabled=$(jq -r --arg id "$plugin_id" '[.npm[]? | select(.name == $id and .enabled == true)] | length' <<<"$listing")
  [[ $count == 1 && $enabled == 1 ]] || fail "OMP did not report exactly one enabled Aperture integration"
  trap - EXIT
  printf 'Aperture is registered with OMP.\nRestart already-open OMP sessions to load the bundled extension.\n'
)

status() {
  listing=$(run_omp plugin list --json)
  jq -c --arg id "$plugin_id" '[.npm[]? | select(.name == $id)]' <<<"$listing"
}

case ${1:-} in
  activate) with_lifecycle_lock activate ;;
  deactivate) with_lifecycle_lock "$remove_command" ;;
  status) status ;;
  -h | --help | "")
    printf 'Usage: omarchy-aperture-omp <activate|deactivate|status>\n'
    ;;
  *) fail "unknown action: $1" ;;
esac

#!/bin/bash

# omarchy:summary=Verify the installed Aperture worker payload
# omarchy:hidden=true

set -euo pipefail

fail() {
  printf 'omarchy-aperture-verify-payload: %s\n' "$1" >&2
  exit 1
}

case ${1:-} in
  --require-production) shift ;;
  *) fail "usage: omarchy-aperture-verify-payload --require-production" ;;
esac
(( $# == 0 )) || fail "unexpected verifier arguments"
required_current_protocol_version=4

resolve_existing() {
  [[ -e $1 || -L $1 ]] || return 1
  realpath "$1"
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

script_path=$(resolve_existing "${BASH_SOURCE[0]}") ||
  fail "cannot resolve the installed verifier path"
bin_dir=${script_path%/*}
plugin_dir=${bin_dir%/*}
plugin_real=$(resolve_existing "$plugin_dir") || fail "cannot resolve the installed plugin directory"
policy="$plugin_dir/config/artifact-policy.json"
buildinfo="$plugin_dir/BUILDINFO.json"

[[ -d $plugin_dir/config && ! -L $plugin_dir/config ]] ||
  fail "artifact policy directory is missing or unsafe"
[[ -f $policy && ! -L $policy ]] || fail "artifact acceptance policy is missing or unsafe"
[[ -f $buildinfo && ! -L $buildinfo ]] || fail "trusted BUILDINFO.json is missing or unsafe"
policy_real=$(resolve_existing "$policy") || fail "cannot resolve artifact acceptance policy"
buildinfo_real=$(resolve_existing "$buildinfo") || fail "cannot resolve trusted BUILDINFO.json"
[[ $policy_real == "$plugin_real/"* ]] || fail "artifact acceptance policy escapes the plugin"
[[ $buildinfo_real == "$plugin_real/"* ]] || fail "BUILDINFO.json escapes the plugin"

jq -e '
  type == "object"
  and (keys | sort) == [
    "apertureCommit",
    "approvedSourceTag",
    "artifactAcceptance",
    "artifactLimits",
    "artifactMode",
    "minimumNodeMajor",
    "minimumNodeVersion",
    "productionEligible",
    "release",
    "versions"
  ]
  and .artifactAcceptance == "production"
  and .productionEligible == true
  and .artifactMode == "omp-only"
  and (.versions.aperture | type == "string" and test("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"))
  and (.versions.apertureCore | type == "string" and test("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"))
  and .versions.ompIntegration == "0.1.0"
  and .minimumNodeVersion == "22.0.0"
  and .minimumNodeMajor == 22
  and .artifactLimits == { maximumTextArtifactBytes: 524288 }
' "$policy" >/dev/null 2>&1 || fail "production artifact policy is malformed"
expected_aperture_version=$(jq -er '.versions.aperture' "$policy") ||
  fail "expected Aperture package version is missing"
expected_core_version=$(jq -er '.versions.apertureCore' "$policy") ||
  fail "expected ApertureCore package version is missing"

approved_tag=$(jq -er '.approvedSourceTag | select(type == "string" and length > 0)' "$policy") ||
  fail "accepted signed source tag is not pinned"
expected_commit=$(jq -er '.apertureCommit | select(type == "string")' "$policy") ||
  fail "expected Aperture commit is missing"
[[ $approved_tag =~ ^aperture-worker-v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  fail "approved source tag is malformed"
[[ $expected_commit =~ ^[0-9a-f]{40}$ ]] || fail "approved source commit is malformed"
expected_tag_ref="refs/tags/$approved_tag"
expected_release_workflow_path=.github/workflows/aperture-worker-release.yml
expected_release_workflow_ref="tomismeta/aperture/$expected_release_workflow_path@$expected_tag_ref"

expected_release_url=$(jq -er '.release.url' "$policy") || fail "approved release URL is missing"
expected_archive_name=$(jq -er '.release.archive.name' "$policy") || fail "archive name is missing"
expected_archive_bytes=$(jq -er '.release.archive.bytes' "$policy") || fail "archive size is missing"
expected_archive_sha=$(jq -er '.release.archive.sha256' "$policy") || fail "archive digest is missing"
expected_buildinfo_path=$(jq -er '.release.buildInfo.path' "$policy") || fail "BUILDINFO path is missing"
expected_buildinfo_bytes=$(jq -er '.release.buildInfo.bytes' "$policy") || fail "BUILDINFO size is missing"
expected_buildinfo_sha=$(jq -er '.release.buildInfo.sha256' "$policy") || fail "BUILDINFO digest is missing"
expected_workflow_name=$(jq -er '.release.workflow.name' "$policy") ||
  fail "release workflow name is missing"
expected_workflow_path=$(jq -er '.release.workflow.path' "$policy") ||
  fail "release workflow path is missing"
expected_workflow_ref=$(jq -er '.release.workflow.ref' "$policy") ||
  fail "release workflow ref is missing"
expected_workflow_run=$(jq -er '.release.workflow.runId | tostring' "$policy") ||
  fail "release workflow run ID is missing"
expected_workflow_attempt=$(jq -er '.release.workflow.runAttempt | tostring' "$policy") ||
  fail "release workflow run attempt is missing"

[[ $expected_release_url == "https://github.com/tomismeta/aperture/releases/tag/$approved_tag" ]] ||
  fail "approved release URL does not match tag"
[[ $expected_archive_name == "$approved_tag.tar.gz" ]] || fail "archive name does not match tag"
[[ $expected_archive_bytes =~ ^[1-9][0-9]*$ ]] || fail "archive size is invalid"
[[ $expected_archive_sha =~ ^[0-9a-f]{64}$ ]] || fail "archive digest is invalid"
[[ $expected_buildinfo_path == BUILDINFO.json ]] || fail "BUILDINFO path is invalid"
[[ $expected_buildinfo_bytes =~ ^[1-9][0-9]*$ ]] || fail "BUILDINFO size is invalid"
[[ $expected_buildinfo_sha =~ ^[0-9a-f]{64}$ ]] || fail "BUILDINFO digest is invalid"
[[ $expected_workflow_name == "Aperture Worker Release" ]] ||
  fail "release workflow name is invalid"
[[ $expected_workflow_path == "$expected_release_workflow_path" ]] ||
  fail "release workflow path is invalid"
[[ $expected_workflow_ref == "$expected_release_workflow_ref" ]] ||
  fail "release workflow ref is invalid"
[[ $expected_workflow_run =~ ^[1-9][0-9]*$ ]] ||
  fail "release workflow run ID is invalid"
[[ $expected_workflow_attempt =~ ^[1-9][0-9]*$ ]] ||
  fail "release workflow run attempt is invalid"

jq -e \
  --arg tagRef "$expected_tag_ref" \
  --arg commit "$expected_commit" \
  --arg workflowName "$expected_workflow_name" \
  --arg workflowPath "$expected_workflow_path" \
  --arg workflowRef "$expected_workflow_ref" \
  --arg workflowRun "$expected_workflow_run" \
  --arg workflowAttempt "$expected_workflow_attempt" '
    (.release | keys | sort) == [
      "archive",
      "buildInfo",
      "environment",
      "immutable",
      "immutableReleasesRequired",
      "protectedMainRef",
      "url",
      "workflow"
    ]
    and .release.immutable == true
    and .release.environment == "aperture-worker-release"
    and .release.immutableReleasesRequired == true
    and .release.protectedMainRef == "refs/heads/main"
    and .release.workflow == {
      name: $workflowName,
      path: $workflowPath,
      ref: $workflowRef,
      runId: $workflowRun,
      runAttempt: $workflowAttempt,
      event: "push",
      sourceRef: $tagRef,
      sourceDigest: $commit,
      conclusion: "success"
    }
  ' "$policy" >/dev/null || fail "signed-tag release workflow policy is invalid"

actual_buildinfo_bytes=$(wc -c <"$buildinfo" | tr -d '[:space:]')
actual_buildinfo_sha=$(sha256sum "$buildinfo" | cut -d' ' -f1)
[[ $actual_buildinfo_bytes == "$expected_buildinfo_bytes" ]] || fail "BUILDINFO byte count mismatch"
[[ $actual_buildinfo_sha == "$expected_buildinfo_sha" ]] || fail "BUILDINFO SHA-256 mismatch"


jq -e \
  --arg tag "$approved_tag" \
  --arg commit "$expected_commit" \
  --arg workflowRef "$expected_release_workflow_ref" \
  --arg workflowRun "$expected_workflow_run" \
  --arg workflowAttempt "$expected_workflow_attempt" \
  --arg apertureVersion "$expected_aperture_version" \
  --arg coreVersion "$expected_core_version" '
    .schemaVersion == 1
    and .artifactType == "node-commonjs-bundle"
    and .worker == "aperture-attention-engine"
    and .minimumNodeVersion == "22.0.0"
    and .minimumNodeMajor == 22
    and .apertureCommit == $commit
    and .apertureSourceTag == $tag
    and .releaseSeries == ($tag | sub("\\.[0-9]+$"; ""))
    and .sourceDirty == false
    and .payloadProfile == "release"
    and .trustedCi == true
    and .aperturePackageVersion == $apertureVersion
    and .apertureCoreVersion == $coreVersion
    and .ompPackageVersion == "0.1.0"
    and .artifactLimits.maximumTextArtifactBytes == 524288
    and .ci.workflowRef == $workflowRef
    and (.ci.runId | tostring) == $workflowRun
    and (.ci.runAttempt | tostring) == $workflowAttempt
    and .runtimeDependencies.policy == "node-builtins-only"
    and .runtimeDependencies.status == "passed"
    and .validation.status == "passed"
    and .validation.ompAdapterProofId == "aperture-omp-adapter-conformance-v1"
    and .validation.directTransportProofId == "aperture-omp-direct-transport-conformance-v1"
    and .validation.directPrivacyProofId == "aperture-omp-direct-privacy-v1"
    and .validation.navigationProofId == "aperture-opaque-focus-navigation-v4"
    and all(.validation.nodeCompatibility[]; .status == "passed")
    and all(.validation.directNodeCompatibility[]; .status == "passed")
    and .artifactMode == "omp-only"
    and .validation.conformanceProofId == "aperture-omp-only-worker-conformance-v1"
    and .validation.ompOnlyReport == "evidence/omp-only-worker.json"
    and (.validation | has("ambientCeilingProofId") | not)
  ' "$buildinfo" >/dev/null || fail "BUILDINFO trust or release workflow contract failed"

jq -e \
  --argjson currentProtocolVersion "$required_current_protocol_version" '
  (.workerContract | keys | sort) == [
    "jsonlHandshakes",
    "notificationInput",
    "ompAttentionEventSchemaVersion",
    "ompWorkerOutputSchemaVersion",
    "surfaceProtocolVersion",
    "workerDirectProtocolVersion"
  ]
  and (.schemas | keys | sort) == [
    "ompAttentionEvent",
    "output",
    "surface",
    "workerDirectMessage"
  ]
  and .workerContract.ompWorkerOutputSchemaVersion == .schemas.output.version
  and .workerContract.ompWorkerOutputSchemaVersion == $currentProtocolVersion
  and .workerContract.surfaceProtocolVersion == $currentProtocolVersion
  and .workerContract.surfaceProtocolVersion == .schemas.surface.version
  and .workerContract.ompAttentionEventSchemaVersion == .schemas.ompAttentionEvent.version
  and .workerContract.ompAttentionEventSchemaVersion == $currentProtocolVersion
  and .workerContract.workerDirectProtocolVersion == .schemas.workerDirectMessage.version
  and .workerContract.workerDirectProtocolVersion == $currentProtocolVersion
  and .workerContract.jsonlHandshakes == {
    privateWorker: {
      protocolVersion: $currentProtocolVersion,
      peer: "aperture-attention-engine",
      framing: "jsonl",
      outputEncoding: "ascii-json-escapes",
      maximumLineBytes: 262144,
      navigation: "validated-opaque-focus-only"
    },
    publicSurface: {
      protocolVersion: $currentProtocolVersion,
      peer: "aperture-stdio",
      framing: "jsonl",
      outputEncoding: "ascii-json-escapes",
      maximumLineBytes: 262144,
      navigation: "absent"
    }
  }
  and .directSocketLifecycle == {
    directoryMode: "0700",
    socketMode: "0600",
    lifecycleLockMode: "0600",
    lifecycleSerialization: "hard-link-owner-lock",
    cleanupDeadlineMs: 1500,
    cleanupExitCodes: { removedOrAbsent: 0, unsafe: 74, transient: 75 },
    startupErrorCode: "direct_transport_unavailable",
    startupExitCodes: { unsafe: 74, transient: 75 },
    startupFailureReadiness: "no-ready-or-snapshot"
  }
  and (has("stateMigration") | not)
  and .focusBackends == ["herdr-0.8.2", "foot-1.27", "tmux-3.7c"]
  and .focusCoordinator.registrationTtlMs == 15000
  and .focusCoordinator.heartbeatIntervalMs == 5000
  and .focusCoordinator.retryInitialMs == 250
  and .focusCoordinator.retryMaximumMs == 5000
  and .focusCoordinator.attentionAcknowledgementTimeoutMs == 1000
  and .focusCoordinator.focusServerProcessingTimeoutMs == 2250
  and .focusCoordinator.activeWindowConfirmationIntervalMs == 25
  and .focusCoordinator.activeWindowConfirmationTimeoutMs == 1000
  and .focusCoordinator.shutdownTimeoutMs == 3000
  and .focusCoordinator.maximumDirectClients == 32
  and .focusCoordinator.maximumDirectReceipts == 1024
  and .focusCoordinator.maximumAmbiguousDeliveryAttempts == 3
  and .focusCoordinator.nativeFallbackPolicy == "definite-pre-write-only"
  and .focusCoordinator.maximumQueuedFocusOperations == 64
  and .focusCoordinator.maximumActiveRegistrations == 128
  and .focusCoordinator.maximumLeaseMembers == 32
  and .focusCoordinator.maximumPendingQmlFocusRequests == 16
  and .focusCoordinator.maximumFocusReplayEvents == 64
  and .focusCoordinator.focusReplayAcknowledgementTimeoutMs == 750
  and .focusCoordinator.maximumConcurrentFocusReplays == 1
  and .focusCoordinator.herdrProtocol == "raw-ndjson-0.8.2"
  and .focusCoordinator.compositorExecutable == "/usr/bin/hyprctl"
  and .focusCoordinator.compositorDispatchTemplate
    == "dispatch hl.dsp.focus({ window = \"address:<validated>\" })"
  and .focusCoordinator.activationResults == ["focused", "stale", "missing"]
  and .focusCoordinator.titleOwnership == "tmux-cas-herdr-retain-no-conditional-clear"
  and .focusCoordinator.herdrTitleRelease == "retained-no-conditional-clear"
  and .focusCoordinator.workerGeneration == "volatile-per-worker"
  and .focusCoordinator.clientPolicy == "backend-scoped-single-client-admission"
  and .focusCoordinator.persistence == "volatile-only"
' "$buildinfo" >/dev/null || fail "worker protocol, socket, state, or focus contract failed"

jq -e '
  .workerContract.notificationInput == false
  and .focusCoordinator.focusAcknowledgementTimeoutMs == 2750
  and .focusCoordinator.sessionHeartbeatIntervalMs == 5000
  and .focusCoordinator.sessionLeaseMs == 20000
  and .focusCoordinator.sessionReconnectGraceMs == 10000
  and .focusCoordinator.maximumSessionLeaseRecords == 128
  and .focusCoordinator.markerAdmission == "exact-marker-and-live-address-only"
' "$buildinfo" >/dev/null || fail "OMP-only worker lifecycle contract failed"

expected_fixture_count=15
expected_file_count=30

jq -e \
  --argjson fixtureCount "$expected_fixture_count" \
  --argjson fileCount "$expected_file_count" '
  .workerBundle.path == "lib/aperture-attention-engine.cjs"
  and (.workerBundle.bytes | type == "number" and . > 0 and . <= 524288)
  and (.workerBundle.sha256 | test("^[0-9a-f]{64}$"))
  and .integrations.omp.artifactType == "omp-extension-module"
  and .integrations.omp.path == "integrations/omp/aperture-omp-extension.mjs"
  and .integrations.omp.manifestPath == "integrations/omp/package.json"
  and .integrations.omp.packageVersion == "0.1.0"
  and (.integrations.omp.bytes | type == "number" and . > 0 and . <= 524288)
  and (.integrations.omp.sha256 | test("^[0-9a-f]{64}$"))
  and .integrations.omp.minimumOmpVersion == "18.0.0"
  and .integrations.omp.proofId == "aperture-omp-adapter-conformance-v1"
  and .integrations.omp.runtimeDependencies.policy == "node-builtins-only"
  and .integrations.omp.runtimeDependencies.status == "passed"
  and .integrations.omp.validation.status == "passed"
  and .integrations.omp.validation.proofId == "aperture-omp-adapter-conformance-v1"
  and .schemas.output.path == "schemas/omp-worker-output.schema.json"
  and .schemas.surface.path == "schemas/surface-protocol.schema.json"
  and .schemas.ompAttentionEvent.path == "schemas/omp-attention-event.schema.json"
  and .schemas.workerDirectMessage.path == "schemas/worker-direct-message.schema.json"
  and .fixtures.ompDirect.version == .workerContract.workerDirectProtocolVersion
  and (.fixtures.ompDirect.paths | type == "array" and length == $fixtureCount)
  and (.files | length == $fileCount)
' "$buildinfo" >/dev/null || fail "BUILDINFO artifact or canonical schema contract failed"

jq -e '
  (.files | type == "array" and length > 0)
  and ([.files[].path] | length == (unique | length))
  and ([.files[].path] == ([.files[].path] | sort))
  and all(.files[];
    (.path | type == "string" and length > 0 and (explode | all(. >= 32 and . != 127)))
    and (.bytes | type == "number" and floor == . and . >= 0)
    and (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
    and .mode == "0644")
' "$buildinfo" >/dev/null || fail "BUILDINFO file manifest is malformed"
identity_config="$plugin_dir/config/identities.json"
[[ ! -e $identity_config && ! -L $identity_config ]] ||
  fail "obsolete OMP identity configuration remains installed"

for directory in lib schemas evidence integrations/omp fixtures/omp-direct; do
  [[ -d $plugin_dir/$directory && ! -L $plugin_dir/$directory ]] ||
    fail "required payload directory is missing or unsafe: $directory"
done

unsafe_link=$(find \
  "$plugin_dir/lib" "$plugin_dir/schemas" "$plugin_dir/evidence" \
  "$plugin_dir/integrations/omp" "$plugin_dir/fixtures/omp-direct" \
  -type l -print -quit)
[[ -z $unsafe_link ]] || fail "payload contains a symlink: ${unsafe_link#"$plugin_dir/"}"

while IFS=$'\t' read -r relative expected_bytes expected_sha expected_mode; do
  case "/$relative/" in
    */../* | */./*) fail "BUILDINFO contains an unsafe path: $relative" ;;
  esac
  case "$relative" in
    lib/* | schemas/* | evidence/* | integrations/omp/* | fixtures/omp-direct/*) ;;
    *) fail "BUILDINFO contains an unexpected path: $relative" ;;
  esac
  artifact="$plugin_dir/$relative"
  [[ -f $artifact && ! -L $artifact ]] || fail "payload file is missing or unsafe: $relative"
  resolved=$(resolve_existing "$artifact") || fail "cannot resolve payload file: $relative"
  [[ $resolved == "$plugin_real/"* ]] || fail "payload file escapes the plugin: $relative"
  actual_bytes=$(wc -c <"$artifact" | tr -d '[:space:]')
  actual_sha=$(sha256sum "$artifact" | cut -d' ' -f1)
  actual_mode=$(file_mode "$artifact")
  [[ $actual_bytes == "$expected_bytes" ]] || fail "payload byte count mismatch: $relative"
  [[ $actual_sha == "$expected_sha" ]] || fail "payload SHA-256 mismatch: $relative"
  [[ $actual_mode == "${expected_mode#0}" ]] || fail "payload mode mismatch: $relative"
done < <(jq -r '.files[] | [.path, (.bytes | tostring), .sha256, .mode] | @tsv' "$buildinfo")

while IFS= read -r -d '' artifact; do
  relative=${artifact#"$plugin_dir/"}
  jq -e --arg path "$relative" '[.files[] | select(.path == $path)] | length == 1' \
    "$buildinfo" >/dev/null || fail "payload file is absent from BUILDINFO: $relative"
done < <(find \
  "$plugin_dir/lib" "$plugin_dir/schemas" "$plugin_dir/evidence" \
  "$plugin_dir/integrations/omp" "$plugin_dir/fixtures/omp-direct" \
  -type f -print0)

for required in \
  evidence/direct-node-22.23.2.json \
  evidence/direct-privacy.json \
  evidence/direct-transport.json \
  evidence/node-22.23.2.json \
  evidence/omp-adapter.json \
  evidence/omp-only-worker.json \
  evidence/omp-runtime-imports.json \
  evidence/runtime-imports.json \
  lib/aperture-attention-engine.cjs \
  integrations/omp/package.json \
  integrations/omp/aperture-omp-extension.mjs \
  schemas/omp-worker-output.schema.json \
  schemas/omp-attention-event.schema.json \
  schemas/worker-direct-message.schema.json \
  schemas/surface-protocol.schema.json \
  fixtures/omp-direct/approval-request.json \
  fixtures/omp-direct/input-request.json \
  fixtures/omp-direct/failure-event.json \
  fixtures/omp-direct/focus-registration.json \
  fixtures/omp-direct/focus-registration-direct-terminal.json \
  fixtures/omp-direct/focus-registration-tmux.json \
  fixtures/omp-direct/focus-activation.json \
  fixtures/omp-direct/focus-result.json \
  fixtures/omp-direct/completion-event.json \
  fixtures/omp-direct/completion-resolved-event.json \
  fixtures/omp-direct/snapshot-failure.json \
  fixtures/omp-direct/snapshot-completion.json \
  fixtures/omp-direct/snapshot-completion-resolved.json \
  fixtures/omp-direct/snapshot-now-next.json \
  fixtures/omp-direct/snapshot-resolved.json; do
  jq -e --arg path "$required" '[.files[] | select(.path == $path)] | length == 1' \
    "$buildinfo" >/dev/null || fail "required payload file is absent: $required"
done

omp_manifest="$plugin_dir/integrations/omp/package.json"
jq -e '
  .name == "@tomismeta/aperture-omp"
  and .version == "0.1.0"
  and .private == true
  and .type == "module"
  and .omp.extensions == ["./aperture-omp-extension.mjs"]
' "$omp_manifest" >/dev/null || fail "private OMP integration manifest is invalid"


printf '%s\n' "$plugin_dir"

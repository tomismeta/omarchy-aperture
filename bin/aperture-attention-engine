#!/bin/bash

set -u

invalid_payload_exit=65
missing_payload_exit=66
missing_node_exit=69
non_production_exit=77
incompatible_exit=78

fail() {
  local status="$1" message="$2"
  printf 'aperture-attention-engine: %s\n' "$message" >&2
  exit "$status"
}

current_uid=$(/usr/bin/id -u) ||
  fail "$missing_node_exit" "cannot determine the current user"

[[ -e ${BASH_SOURCE[0]} || -L ${BASH_SOURCE[0]} ]] ||
  fail "$missing_payload_exit" "installed launcher path is missing"
script_path=$(realpath "${BASH_SOURCE[0]}") ||
  fail "$missing_payload_exit" "cannot resolve the installed launcher path"
bin_dir=${script_path%/*}
plugin_dir=${bin_dir%/*}
verify_command="$bin_dir/omarchy-aperture-verify-payload"
bundle="$plugin_dir/lib/aperture-attention-engine.cjs"
policy="$plugin_dir/config/artifact-policy.json"
buildinfo="$plugin_dir/BUILDINFO.json"
release_report="$plugin_dir/release/release-report.json"
omp_manifest="$plugin_dir/integrations/omp/package.json"
omp_extension="$plugin_dir/integrations/omp/aperture-omp-extension.mjs"

[[ -x $verify_command ]] ||
  fail "$missing_payload_exit" "payload verifier is missing"
for required_file in \
  "$bundle" \
  "$policy" \
  "$buildinfo" \
  "$release_report" \
  "$omp_manifest" \
  "$omp_extension"; do
  [[ -f $required_file && ! -L $required_file ]] ||
    fail "$missing_payload_exit" "installed payload is incomplete"
done
jq -e '
  type == "object"
  and (keys | sort) == [
    "apertureCommit",
    "approvedSourceTag",
    "artifactAcceptance",
    "artifactLimits",
    "artifactMode",
    "minimumNodeMajor",
    "minimumNodeVersion",
    "productionEligible",
    "release",
    "versions"
  ]
  and .artifactAcceptance == "production"
  and .productionEligible == true
  and .artifactMode == "omp-only"
' "$policy" >/dev/null 2>&1 ||
  fail "$non_production_exit" "installed payload is not the approved production profile"
"$verify_command" --require-production >/dev/null ||
  fail "$invalid_payload_exit" "installed payload failed provenance verification"

[[ ${HOME:-} == /* ]] ||
  fail "$missing_node_exit" "HOME is not an absolute stock user path"
home_real=$(realpath "$HOME") ||
  fail "$missing_node_exit" "cannot resolve the stock user home"
mise_root="$home_real/.local/share/mise"
mise_shim="$mise_root/shims/node"
[[ -d $mise_root && ! -L $mise_root && -x $mise_shim ]] ||
  fail "$missing_node_exit" "Node is missing; repair the standard Omarchy mise runtime"
node_path=$(realpath "$mise_shim") ||
  fail "$missing_node_exit" "cannot resolve the standard Omarchy mise Node shim"
install_prefix="$mise_root/installs/node/"
if [[ $node_path != "$install_prefix"* ]]; then
  mise_command=/usr/bin/mise
  [[ -f $mise_command && ! -L $mise_command && -x $mise_command ]] ||
    fail "$missing_node_exit" "the stock Omarchy mise command is unavailable"
  mise_uid=$(stat -c '%u' "$mise_command" 2>/dev/null || stat -f '%u' "$mise_command") ||
    fail "$missing_node_exit" "cannot inspect the stock Omarchy mise command"
  mise_mode=$(stat -c '%a' "$mise_command" 2>/dev/null || stat -f '%Lp' "$mise_command") ||
    fail "$missing_node_exit" "cannot inspect the stock Omarchy mise command"
  [[ $mise_uid == 0 && $mise_mode =~ ^[0-7]{3,4}$ ]] ||
    fail "$missing_node_exit" "the stock Omarchy mise command is not root-owned"
  (( (8#$mise_mode & 0022) == 0 )) ||
    fail "$missing_node_exit" "the stock Omarchy mise command is writable by untrusted users"
  node_candidate=$(env -u NODE_OPTIONS -u NODE_PATH \
    HOME="$home_real" MISE_DATA_DIR="$mise_root" "$mise_command" which node 2>/dev/null) ||
    fail "$missing_node_exit" "mise has no active Node interpreter"
  [[ $node_candidate == /* && $node_candidate != *$'\n'* ]] ||
    fail "$missing_node_exit" "mise returned a non-canonical Node path"
  node_path=$(realpath "$node_candidate") ||
    fail "$missing_node_exit" "cannot resolve the mise-selected Node interpreter"
fi
[[ $node_path == "$install_prefix"* ]] ||
  fail "$missing_node_exit" "mise Node resolves outside the standard Omarchy runtime"
install_relative=${node_path#"$install_prefix"}
node_version_dir=${install_relative%%/*}
[[ -n $node_version_dir && $install_relative == "$node_version_dir/bin/node" ]] ||
  fail "$missing_node_exit" "mise Node resolves to a non-canonical interpreter path"
[[ -f $node_path && ! -L $node_path && -x $node_path ]] ||
  fail "$missing_node_exit" "canonical mise Node is not an executable regular file"
node_uid=$(stat -c '%u' "$node_path" 2>/dev/null || stat -f '%u' "$node_path") ||
  fail "$missing_node_exit" "cannot inspect canonical mise Node ownership"
node_mode=$(stat -c '%a' "$node_path" 2>/dev/null || stat -f '%Lp' "$node_path") ||
  fail "$missing_node_exit" "cannot inspect canonical mise Node permissions"
[[ $node_uid == "$current_uid" && $node_mode =~ ^[0-7]{3,4}$ ]] ||
  fail "$missing_node_exit" "canonical mise Node is not owned by the current user"
(( (8#$node_mode & 0022) == 0 )) ||
  fail "$missing_node_exit" "canonical mise Node is group- or world-writable"

version=$({ env -u NODE_OPTIONS -u NODE_PATH "$node_path" --version; } 2>/dev/null || true)
[[ $version =~ ^v([0-9]+)(\.[0-9]+){2}$ ]] ||
  fail "$incompatible_exit" "installed Node returned an invalid version"
(( 10#${BASH_REMATCH[1]} >= 22 )) ||
  fail "$incompatible_exit" "installed Node is older than 22"

exec env -u NODE_OPTIONS -u NODE_PATH \
  "$node_path" "$bundle" "$@"

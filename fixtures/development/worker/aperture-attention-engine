#!/bin/bash

set -u

# Development-only launcher proof. The production manifest never references
# this file. The payload path exists only in the caller's untracked environment.
incompatible_exit=78
missing_bundle_exit=66
payload_dir="${APERTURE_ATTENTION_DEV_PAYLOAD_DIR:-}"

fail() {
  local status="$1" message="$2"
  printf 'aperture-attention-engine (development): %s\n' "$message" >&2
  exit "$status"
}

[[ $payload_dir == /* ]] ||
  fail "$missing_bundle_exit" "set APERTURE_ATTENTION_DEV_PAYLOAD_DIR to an absolute local payload directory"

bundle="$payload_dir/lib/aperture-attention-engine.cjs"
[[ -f $bundle ]] ||
  fail "$missing_bundle_exit" "worker bundle is missing from the development payload"

candidates=()
candidate_count=0
path_node=$(command -v node 2>/dev/null || true)
if [[ -n $path_node ]]; then
  candidates[$candidate_count]="$path_node"
  (( candidate_count += 1 ))
fi

mise_node="${HOME:-}/.local/share/mise/shims/node"
if [[ -x $mise_node && $mise_node != "$path_node" ]]; then
  candidates[$candidate_count]="$mise_node"
  (( candidate_count += 1 ))
fi

for (( index = 0; index < candidate_count; index++ )); do
  node_path="${candidates[$index]}"
  version=$({ "$node_path" --version; } 2>/dev/null || true)
  if [[ $version =~ ^v([0-9]+)(\.[0-9]+){2}$ ]] && (( 10#${BASH_REMATCH[1]} >= 22 )); then
    exec "$node_path" "$bundle" "$@"
  fi
done

fail "$incompatible_exit" "Node 22 or newer is unavailable; repair the standard Omarchy mise runtime"

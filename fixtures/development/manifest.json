{
  "schemaVersion": 1,
  "id": "aperture.fixtures",
  "name": "Aperture Fixtures",
  "version": "0.1.0",
  "author": "tomismeta",
  "license": "MIT",
  "description": "Development-only fixture scenarios for the Aperture panel.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "fixtures/development/Panel.qml"
  },
  "barWidget": {
    "displayName": "Aperture Fixtures",
    "category": "AI",
    "aliases": ["aperture-fixtures"],
    "allowMultiple": false,
    "defaults": {
      "scenario": "calm",
      "privacyMode": "false"
    },
    "schema": [
      {
        "key": "scenario",
        "type": "enum",
        "label": "Fixture scenario",
        "options": [
          "calm",
          "hierarchy",
          "next-only",
          "non-navigable-now",
          "privacy",
          "rapid-versions",
          "pending-focus",
          "keyboard-selection",
          "ambient-expanded",
          "long-text",
          "clipping",
          "no-source",
          "connecting",
          "disconnected",
          "degraded",
          "start-failed",
          "malformed",
          "protocol-mismatch",
          "minimal-frame",
          "surface-error",
          "out-of-order"
        ],
        "defaultValue": "calm"
      },
      {
        "key": "privacyMode",
        "type": "boolean",
        "label": "Start with details hidden",
        "defaultValue": "false"
      }
    ]
  }
}
